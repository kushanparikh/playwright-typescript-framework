  "bugs": {
    "url": "https://github.com/kushanparikh/playwright-typescript-framework/issues"
  },
  "homepage": "https://github.com/kushanparikh/playwright-typescript-framework#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3"
  }
}
